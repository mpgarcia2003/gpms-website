e":"2018","address":{"@type":"PostalAddress","streetAddress":"1420 Outlook Ave","addressLocality":"Bronx","addressRegion":"NY","postalCode":"10465","addressCountry":"US"},"areaServed":[{"@type":"State","name":"New York"},{"@type":"State","name":"New Jersey"},{"@type":"State","name":"Connecticut"},{"@type":"State","name":"Pennsylvania"},{"@type":"State","name":"Florida"}],"knowsAbout":["Commercial Janitorial","Disinfection & Sanitization","Floor Care","Day Porter Services","Facility Maintenance","Post-Construction Cleanup"],"numberOfEmployees":{"@type":"QuantitativeValue","minValue":80},"naics":"561720"}0:["zD84zgCHYzEIZPbtDt1yS",[[["",{"children":["blog",{"children":[["slug","cleaning-company-insurance-requirements","d"],{"children":["__PAGE__?{\"slug\":\"cleaning-company-insurance-requirements\"}",{}]}]}]},"$undefined","$undefined",true],["",{"children":["blog",{"children":[["slug","cleaning-company-insurance-requirements","d"],{"children":["__PAGE__",{},[["$L1",["$","div",null,{"style":{"fontFamily":"'Plus Jakarta Sans', sans-serif","background":"#FFFFFF"},"children":[["$","style",null,{"children":"\n        .blog-link { color: #1B7A3D; text-decoration: underline; text-underline-offset: 2px; }\n        .blog-link:hover { color: #16683A; }\n        .blog-related:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.08); }\n      "}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"Cleaning Company Insurance Requirements: What to Verify Before Signing a Contract\",\"description\":\"The essential insurance coverages every commercial cleaning company should carry — general liability, workers' compensation, commercial auto, and umbrella policies explained.\",\"datePublished\":\"2026-03-01\",\"author\":{\"@type\":\"Organization\",\"name\":\"GreenPoint Maintenance Services Corp\",\"url\":\"https://greenpointms.com\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"GreenPoint Maintenance Services Corp\",\"url\":\"https://greenpointms.com\"},\"mainEntityOfPage\":\"https://greenpointms.com/blog/cleaning-company-insurance-requirements/\",\"keywords\":\"cleaning company insurance requirements, janitorial insurance coverage, commercial cleaning liability insurance\"}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://greenpointms.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Blog\",\"item\":\"https://greenpointms.com/blog/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Cleaning Company Insurance Requirements: What to Verify Before Signing a Contract\"}]}"}}],["$","$L2",null,{}],["$","section",null,{"style":{"background":"#0A2A16","paddingTop":140,"paddingBottom":64,"position":"relative","overflow":"hidden"},"children":[["$","div",null,{"style":{"position":"absolute","inset":0,"opacity":0.04,"backgroundImage":"linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px)","backgroundSize":"60px 60px","pointerEvents":"none"}}],["$","div",null,{"style":{"maxWidth":720,"margin":"0 auto","padding":"0 24px","position":"relative","zIndex":1},"children":[["$","nav",null,{"style":{"display":"flex","gap":8,"alignItems":"center","marginBottom":24,"flexWrap":"wrap"},"children":[["$","a",null,{"href":"/","style":{"fontFamily":"'JetBrains Mono', monospace","fontSize":11,"color":"rgba(255,255,255,0.4)","textDecoration":"none","fontWeight":600,"letterSpacing":"0.05em"},"children":"Home"}],["$","span",null,{"style":{"color":"rgba(255,255,255,0.2)","fontSize":12},"children":"›"}],["$","a",null,{"href":"/blog/","style":{"fontFamily":"'JetBrains Mono', monospace","fontSize":11,"color":"rgba(255,255,255,0.4)","textDecoration":"none","fontWeight":600,"letterSpacing":"0.05em"},"children":"Blog"}],["$","span",null,{"style":{"color":"rgba(255,255,255,0.2)","fontSize":12},"children":"›"}],["$","span",null,{"style":{"fontFamily":"'JetBrains Mono', monospace","fontSize":11,"color":"#C8A34D","fontWeight":600,"letterSpacing":"0.05em"},"children":"Business"}]]}],["$","div",null,{"style":{"display":"flex","alignItems":"center","gap":12,"marginBottom":20,"flexWrap":"wrap"},"children":[["$","span",null,{"style":{"background":"rgba(200,163,77,0.15)","color":"#C8A34D","padding":"4px 10px","borderRadius":4,"fontSize":11,"fontWeight":600,"fontFamily":"'JetBrains Mono', monospace","letterSpacing":"0.05em"},"children":"Business"}],["$","span",null,{"style":{"fontSize":12,"color":"rgba(255,255,255,0.4)","fontFamily":"'JetBrains Mono', monospace"},"children":"March 1, 2026"}],["$","span",null,{"style":{"fontSize":12,"color":"rgba(255,255,255,0.4)","fontFamily":"'JetBrains Mono', monospace"},"children":["· ","7 min read"]}]]}],["$","h1",null,{"style":{"fontFamily":"'Syne', sans-serif","fontSize":"clamp(28px, 4vw, 42px)","fontWeight":700,"color":"#fff","lineHeight":1.15,"marginBottom":0,"letterSpacing":"-0.02em"},"children":"Cleaning Company Insurance Requirements: What to Verify Before Signing a Contract"}]]}]]}],"$undefined",["$","article",null,{"style":{"maxWidth":720,"margin":"0 auto","padding":"48px 24px 64px"},"children":[[["$","p","0",{"style":{"fontSize":18,"color":"#1A2B1F","lineHeight":1.8,"marginBottom":32,"fontWeight":500},"children":"When a cleaning company's employee slips on your wet floor and breaks a wrist, when a buffer scratches an expensive marble lobby, or when a cleaning solution damages a tenant's equipment — who pays? The answer depends entirely on the cleaning company's insurance coverage. Yet many facility managers sign cleaning contracts without verifying insurance, or accept a certificate of insurance without understanding what it actually covers. This guide explains the essential coverages and how to verify them."}],["$","h2","1",{"style":{"fontFamily":"'Syne', sans-serif","fontSize":22,"fontWeight":700,"color":"#1A2B1F","lineHeight":1.25,"marginTop":40,"marginBottom":16,"letterSpacing":"-0.01em"},"children":"General Liability Insurance"}],["$","p","2",{"style":{"fontSize":16,"color":"#4A5E52","lineHeight":1.8,"marginBottom":20},"children":"Commercial general liability (CGL) insurance covers third-party bodily injury and property damage caused by the cleaning company's operations. If a visitor slips on a freshly mopped floor, if cleaning chemicals damage a tenant's property, or if a cleaning cart dents an elevator door — CGL covers the claim. Industry standard minimums are $1 million per occurrence and $2 million aggregate. For larger facilities or higher-risk environments (healthcare, government), $2 million per occurrence and $5 million aggregate may be appropriate. Always verify that the policy is occurrence-based (covers incidents during the policy period regardless of when claims are filed) rather than claims-made (which can leave gaps)."}],["$","h2","3",{"style":{"fontFamily":"'Syne', sans-serif","fontSize":22,"fontWeight":700,"color":"#1A2B1F","lineHeight":1.25,"marginTop":40,"marginBottom":16,"letterSpacing":"-0.01em"},"children":"Workers' Compensation"}],["$","p","4",{"style":{"fontSize":16,"color":"#4A5E52","lineHeight":1.8,"marginBottom":20},"children":"Workers' compensation is legally required in all 50 states for employees. It covers medical expenses and lost wages when a cleaning employee is injured on the job. Without workers' comp, an injured employee could file a claim directly against your facility — even though they work for the cleaning company. Verify that the cleaning company's workers' comp policy is active and covers all employees working in your facility. Be cautious of companies using 1099 independent contractors rather than W-2 employees — independent contractor misclassification is rampant in the cleaning industry, and it can leave your facility exposed if an uninsured worker is injured on your premises."}],["$","h2","5",{"style":{"fontFamily":"'Syne', sans-serif","fontSize":22,"fontWeight":700,"color":"#1A2B1F","lineHeight":1.25,"marginTop":40,"marginBottom":16,"letterSpacing":"-0.01em"},"children":"Additional Insured Status"}],["$","p","6",{"style":{"fontSize":16,"color":"#4A5E52","lineHeight":1.8,"marginBottom":20},"children":"Requiring the cleaning company to add your organization as an additional insured on their CGL policy is critical. Additional insured status means their insurance responds first if a claim arises from their work at your facility — before your own insurance is triggered. Without additional insured status, you might need to file a claim on your own policy and then seek reimbursement from the cleaning company's insurer, a process that's slow and uncertain. Request a certificate of insurance naming your organization as additional insured before the contract starts, and require automatic notification if the policy is cancelled or modified."}],["$","h2","7",{"style":{"fontFamily":"'Syne', sans-serif","fontSize":22,"fontWeight":700,"color":"#1A2B1F","lineHeight":1.25,"marginTop":40,"marginBottom":16,"letterSpacing":"-0.01em"},"children":"How to Verify Insurance"}],["$","p","8",{"style":{"fontSize":16,"color":"#4A5E52","lineHeight":1.8,"marginBottom":20},"children":"Don't accept a certificate of insurance at face value — certificates can be outdated, forged, or for policies that have since been cancelled. Best practices include requesting certificates directly from the insurance carrier or agent (not from the cleaning company), verifying the policy is current by calling the carrier's verification line, confirming that the coverage types and limits match your contract requirements, requesting 30-day advance notice of cancellation, and re-verifying insurance annually at contract renewal. Many facility management companies now use automated insurance tracking platforms that monitor coverage status in real-time and alert managers when coverage lapses."}],["$","div","9",{"style":{"background":"#F0F7F2","borderLeft":"3px solid #1B7A3D","padding":"20px 24px","borderRadius":"0 8px 8px 0","margin":"32px 0"},"children":["$","p",null,{"style":{"fontSize":15,"color":"#1A2B1F","lineHeight":1.7,"fontWeight":500,"margin":0},"children":"GreenPoint maintains comprehensive insurance coverage including $2M general liability, full workers' compensation, commercial auto, and umbrella policies. We provide certificates of insurance with additional insured endorsements as a standard practice for all clients."}]}]],["$","div",null,{"style":{"borderTop":"1px solid #E2EBE5","marginTop":48,"paddingTop":32,"display":"flex","flexDirection":"column","gap":16},"children":[["$","div",null,{"style":{"display":"flex","alignItems":"center","gap":14},"children":[["$","div",null,{"style":{"width":48,"height":48,"borderRadius":8,"background":"#1B7A3D","display":"flex","alignItems":"center","justifyContent":"center","color":"#fff","fontWeight":800,"fontFamily":"'Syne', sans-serif","fontSize":20},"children":"G"}],["$","div",null,{"children":[["$","div",null,{"style":{"fontWeight":600,"color":"#1A2B1F","fontSize":15},"children":"GreenPoint Maintenance Services"}],["$","div",null,{"style":{"fontSize":13,"color":"#8A9B91"},"children":"MBE-Certified Commercial Cleaning · NY, NJ, CT, PA, FL"}]]}]]}],["$","a",null,{"href":"/#schedule","style":{"display":"inline-flex","alignItems":"center","gap":8,"background":"#1B7A3D","color":"#fff","padding":"12px 24px","borderRadius":8,"fontWeight":700,"fontSize":13,"textDecoration":"none","fontFamily":"'Syne', sans-serif","letterSpacing":"0.04em","alignSelf":"flex-start"},"children":"Schedule a Free Walkthrough →"}]]}]]}],["$","section",null,{"style":{"background":"#F7FAF8","padding":"64px 24px","borderTop":"1px solid #E2EBE5"},"children":["$","div",null,{"style":{"maxWidth":900,"margin":"0 auto"},"children":[["$","div",null,{"style":{"display":"flex","alignItems":"center","gap":12,"marginBottom":24},"children":[["$","div",null,{"style":{"height":1,"width":32,"background":"rgba(200,163,77,0.3)"}}],["$","h3",null,{"style":{"fontFamily":"'JetBrains Mono', monospace","fontSize":10,"color":"#C8A34D","fontWeight":700,"letterSpacing":"0.15em","textTransform":"uppercase","margin":0},"children":"Related Articles"}]]}],["$","div",null,{"style":{"display":"grid","gridTemplateColumns":"repeat(auto-fill, minmax(260px, 1fr))","gap":16},"children":[["$","a","commercial-cleaning-vs-in-house-custodial",{"href":"/blog/commercial-cleaning-vs-in-house-custodial/","className":"blog-related","style":{"display":"block","textDecoration":"none","background":"#FFFFFF","borderRadius":10,"border":"1px solid #E2EBE5","padding":20,"transition":"transform 0.2s ease, box-shadow 0.2s ease"},"children":[["$","span",null,{"style":{"fontSize":11,"color":"#8A9B91","fontFamily":"'JetBrains Mono', monospace","fontWeight":600},"children":"Business"}],["$","h4",null,{"style":{"fontFamily":"'Syne', sans-serif","fontSize":16,"fontWeight":700,"color":"#1A2B1F","lineHeight":1.3,"margin":"8px 0 8px","letterSpacing":"-0.01em"},"children":"Outsourced Cleaning vs. In-House Custodial Staff: A Complete Comparison"}],["$","span",null,{"style":{"fontSize":12,"color":"#1B7A3D","fontWeight":600},"children":"Read →"}]]}],["$","a","quality-assurance-commercial-cleaning-program",{"href":"/blog/quality-assurance-commercial-cleaning-program/","className":"blog-related","style":{"display":"block","textDecoration":"none","background":"#FFFFFF","borderRadius":10,"border":"1px solid #E2EBE5","padding":20,"transition":"transform 0.2s ease, box-shadow 0.2s ease"},"children":[["$","span",null,{"style":{"fontSize":11,"color":"#8A9B91","fontFamily":"'JetBrains Mono', monospace","fontWeight":600},"children":"Business"}],["$","h4",null,{"style":{"fontFamily":"'Syne', sans-serif","fontSize":16,"fontWeight":700,"color":"#1A2B1F","lineHeight":1.3,"margin":"8px 0 8px","letterSpacin