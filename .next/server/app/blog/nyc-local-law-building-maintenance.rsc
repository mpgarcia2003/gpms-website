e":"2018","address":{"@type":"PostalAddress","streetAddress":"1420 Outlook Ave","addressLocality":"Bronx","addressRegion":"NY","postalCode":"10465","addressCountry":"US"},"areaServed":[{"@type":"State","name":"New York"},{"@type":"State","name":"New Jersey"},{"@type":"State","name":"Connecticut"},{"@type":"State","name":"Pennsylvania"},{"@type":"State","name":"Florida"}],"knowsAbout":["Commercial Janitorial","Disinfection & Sanitization","Floor Care","Day Porter Services","Facility Maintenance","Post-Construction Cleanup"],"numberOfEmployees":{"@type":"QuantitativeValue","minValue":80},"naics":"561720"}0:["zD84zgCHYzEIZPbtDt1yS",[[["",{"children":["blog",{"children":[["slug","nyc-local-law-building-maintenance","d"],{"children":["__PAGE__?{\"slug\":\"nyc-local-law-building-maintenance\"}",{}]}]}]},"$undefined","$undefined",true],["",{"children":["blog",{"children":[["slug","nyc-local-law-building-maintenance","d"],{"children":["__PAGE__",{},[["$L1",["$","div",null,{"style":{"fontFamily":"'Plus Jakarta Sans', sans-serif","background":"#FFFFFF"},"children":[["$","style",null,{"children":"\n        .blog-link { color: #1B7A3D; text-decoration: underline; text-underline-offset: 2px; }\n        .blog-link:hover { color: #16683A; }\n        .blog-related:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.08); }\n      "}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"NYC Local Law Compliance for Commercial Building Maintenance\",\"description\":\"Key New York City local laws that affect commercial building maintenance — from Local Law 11 facade inspections to energy benchmarking, and how cleaning operations intersect with compliance.\",\"datePublished\":\"2026-02-13\",\"author\":{\"@type\":\"Organization\",\"name\":\"GreenPoint Maintenance Services Corp\",\"url\":\"https://greenpointms.com\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"GreenPoint Maintenance Services Corp\",\"url\":\"https://greenpointms.com\"},\"mainEntityOfPage\":\"https://greenpointms.com/blog/nyc-local-law-building-maintenance/\",\"keywords\":\"NYC local law building maintenance, NYC building compliance cleaning, New York City building maintenance requirements\"}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://greenpointms.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Blog\",\"item\":\"https://greenpointms.com/blog/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"NYC Local Law Compliance for Commercial Building Maintenance\"}]}"}}],["$","$L2",null,{}],["$","section",null,{"style":{"background":"#0A2A16","paddingTop":140,"paddingBottom":64,"position":"relative","overflow":"hidden"},"children":[["$","div",null,{"style":{"position":"absolute","inset":0,"opacity":0.04,"backgroundImage":"linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px)","backgroundSize":"60px 60px","pointerEvents":"none"}}],["$","div",null,{"style":{"maxWidth":720,"margin":"0 auto","padding":"0 24px","position":"relative","zIndex":1},"children":[["$","nav",null,{"style":{"display":"flex","gap":8,"alignItems":"center","marginBottom":24,"flexWrap":"wrap"},"children":[["$","a",null,{"href":"/","style":{"fontFamily":"'JetBrains Mono', monospace","fontSize":11,"color":"rgba(255,255,255,0.4)","textDecoration":"none","fontWeight":600,"letterSpacing":"0.05em"},"children":"Home"}],["$","span",null,{"style":{"color":"rgba(255,255,255,0.2)","fontSize":12},"children":"›"}],["$","a",null,{"href":"/blog/","style":{"fontFamily":"'JetBrains Mono', monospace","fontSize":11,"color":"rgba(255,255,255,0.4)","textDecoration":"none","fontWeight":600,"letterSpacing":"0.05em"},"children":"Blog"}],["$","span",null,{"style":{"color":"rgba(255,255,255,0.2)","fontSize":12},"children":"›"}],["$","span",null,{"style":{"fontFamily":"'JetBrains Mono', monospace","fontSize":11,"color":"#C8A34D","fontWeight":600,"letterSpacing":"0.05em"},"children":"Compliance"}]]}],["$","div",null,{"style":{"display":"flex","alignItems":"center","gap":12,"marginBottom":20,"flexWrap":"wrap"},"children":[["$","span",null,{"style":{"background":"rgba(200,163,77,0.15)","color":"#C8A34D","padding":"4px 10px","borderRadius":4,"fontSize":11,"fontWeight":600,"fontFamily":"'JetBrains Mono', monospace","letterSpacing":"0.05em"},"children":"Compliance"}],["$","span",null,{"style":{"fontSize":12,"color":"rgba(255,255,255,0.4)","fontFamily":"'JetBrains Mono', monospace"},"children":"February 13, 2026"}],["$","span",null,{"style":{"fontSize":12,"color":"rgba(255,255,255,0.4)","fontFamily":"'JetBrains Mono', monospace"},"children":["· ","7 min read"]}]]}],["$","h1",null,{"style":{"fontFamily":"'Syne', sans-serif","fontSize":"clamp(28px, 4vw, 42px)","fontWeight":700,"color":"#fff","lineHeight":1.15,"marginBottom":0,"letterSpacing":"-0.02em"},"children":"NYC Local Law Compliance for Commercial Building Maintenance"}]]}]]}],"$undefined",["$","article",null,{"style":{"maxWidth":720,"margin":"0 auto","padding":"48px 24px 64px"},"children":[[["$","p","0",{"style":{"fontSize":18,"color":"#1A2B1F","lineHeight":1.8,"marginBottom":32,"fontWeight":500},"children":"New York City's regulatory environment for commercial buildings is among the most complex in the country. Multiple local laws govern building maintenance, energy performance, indoor air quality, and occupant safety — and several of these intersect directly with cleaning and facility maintenance operations. This guide covers the NYC-specific requirements that facility managers and building owners need to understand."}],["$","h2","1",{"style":{"fontFamily":"'Syne', sans-serif","fontSize":22,"fontWeight":700,"color":"#1A2B1F","lineHeight":1.25,"marginTop":40,"marginBottom":16,"letterSpacing":"-0.01em"},"children":"Local Law 11: Facade Inspection and Safety"}],["$","p","2",{"style":{"fontSize":16,"color":"#4A5E52","lineHeight":1.8,"marginBottom":20},"children":"Local Law 11 (FISP — Facade Inspection and Safety Program) requires buildings over six stories to inspect exterior walls and appurtenances every five years. While the inspection itself is performed by licensed engineers, the resulting repair work often includes facade cleaning, pressure washing, and exterior window cleaning. Building maintenance teams must understand FISP cycle timing and coordinate exterior cleaning with required inspection and repair schedules. Deferred facade maintenance can escalate from a cleaning issue to a structural safety citation."}],["$","h2","3",{"style":{"fontFamily":"'Syne', sans-serif","fontSize":22,"fontWeight":700,"color":"#1A2B1F","lineHeight":1.25,"marginTop":40,"marginBottom":16,"letterSpacing":"-0.01em"},"children":"Local Law 97: Building Emissions and Energy"}],["$","p","4",{"style":{"fontSize":16,"color":"#4A5E52","lineHeight":1.8,"marginBottom":20},"children":"Local Law 97 sets carbon emission limits for buildings over 25,000 sq ft, with penalties beginning in 2024 and limits tightening in 2030. While this is primarily an energy and HVAC issue, cleaning operations intersect in several ways: efficient cleaning equipment (battery-powered vs. older high-energy models) contributes to energy reduction, cleaning schedules can be optimized to align with energy management (cleaning during off-peak hours), and HVAC filter maintenance — often handled by facility maintenance staff — directly impacts building energy efficiency. Green cleaning products with lower VOC content also contribute to indoor air quality metrics that increasingly appear alongside energy benchmarking."}],["$","h2","5",{"style":{"fontFamily":"'Syne', sans-serif","fontSize":22,"fontWeight":700,"color":"#1A2B1F","lineHeight":1.25,"marginTop":40,"marginBottom":16,"letterSpacing":"-0.01em"},"children":"Local Law 26: Cleaning Product Disclosure"}],["$","p","6",{"style":{"fontSize":16,"color":"#4A5E52","lineHeight":1.8,"marginBottom":20},"children":"New York City's Local Law 26 requires that building owners and cleaning contractors disclose the cleaning products used in commercial buildings. Specifically, buildings must maintain a list of all cleaning products used on-site, make this list available to building occupants upon request, and identify products that carry green certifications (Green Seal, EPA Safer Choice, etc.). This transparency requirement means that cleaning companies must maintain accurate, up-to-date product inventories for every NYC building they serve — and that product selection has reputational as well as operational implications."}],["$","h2","7",{"style":{"fontFamily":"'Syne', sans-serif","fontSize":22,"fontWeight":700,"color":"#1A2B1F","lineHeight":1.25,"marginTop":40,"marginBottom":16,"letterSpacing":"-0.01em"},"children":"Local Law 37: Pesticide and Pest Management"}],["$","p","8",{"style":{"fontSize":16,"color":"#4A5E52","lineHeight":1.8,"marginBottom":20},"children":"Local Law 37 requires city agencies and their contractors to use integrated pest management (IPM) practices that minimize pesticide use. For cleaning operations in government buildings, this means that sanitation-based pest prevention (eliminating food sources, sealing entry points, maintaining clean conditions) is the first line of defense, and chemical pesticide use is restricted to situations where non-chemical methods have been insufficient. Cleaning protocols in government facilities must consider pest prevention as an explicit outcome — clean kitchens, sealed trash, and dry conditions prevent pest issues that would otherwise require chemical intervention."}],["$","div","9",{"style":{"background":"#F0F7F2","borderLeft":"3px solid #1B7A3D","padding":"20px 24px","borderRadius":"0 8px 8px 0","margin":"32px 0"},"children":["$","p",null,{"style":{"fontSize":15,"color":"#1A2B1F","lineHeight":1.7,"fontWeight":500,"margin":0},"children":"GreenPoint operates across NYC's complex regulatory environment with full compliance across applicable local laws. Our product disclosure documentation meets Local Law 26 requirements, our green cleaning program aligns with sustainability mandates, and our operations in government buildings comply with IPM requirements under Local Law 37."}]}]],["$","div",null,{"style":{"borderTop":"1px solid #E2EBE5","marginTop":48,"paddingTop":32,"display":"flex","flexDirection":"column","gap":16},"children":[["$","div",null,{"style":{"display":"flex","alignItems":"center","gap":14},"children":[["$","div",null,{"style":{"width":48,"height":48,"borderRadius":8,"background":"#1B7A3D","display":"flex","alignItems":"center","justifyContent":"center","color":"#fff","fontWeight":800,"fontFamily":"'Syne', sans-serif","fontSize":20},"children":"G"}],["$","div",null,{"children":[["$","div",null,{"style":{"fontWeight":600,"color":"#1A2B1F","fontSize":15},"children":"GreenPoint Maintenance Services"}],["$","div",null,{"style":{"fontSize":13,"color":"#8A9B91"},"children":"MBE-Certified Commercial Cleaning · NY, NJ, CT, PA, FL"}]]}]]}],["$","a",null,{"href":"/#schedule","style":{"display":"inline-flex","alignItems":"center","gap":8,"background":"#1B7A3D","color":"#fff","padding":"12px 24px","borderRadius":8,"fontWeight":700,"fontSize":13,"textDecoration":"none","fontFamily":"'Syne', sans-serif","letterSpacing":"0.04em","alignSelf":"flex-start"},"children":"Schedule a Free Walkthrough →"}]]}]]}],["$","section",null,{"style":{"background":"#F7FAF8","padding":"64px 24px","borderTop":"1px solid #E2EBE5"},"children":["$","div",null,{"style":{"maxWidth":900,"margin":"0 auto"},"children":[["$","div",null,{"style":{"display":"flex","alignItems":"center","gap":12,"marginBottom":24},"children":[["$","div",null,{"style":{"height":1,"width":32,"background":"rgba(200,163,77,0.3)"}}],["$","h3",n