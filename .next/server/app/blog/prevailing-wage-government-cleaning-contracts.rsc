e":"2018","address":{"@type":"PostalAddress","streetAddress":"1420 Outlook Ave","addressLocality":"Bronx","addressRegion":"NY","postalCode":"10465","addressCountry":"US"},"areaServed":[{"@type":"State","name":"New York"},{"@type":"State","name":"New Jersey"},{"@type":"State","name":"Connecticut"},{"@type":"State","name":"Pennsylvania"},{"@type":"State","name":"Florida"}],"knowsAbout":["Commercial Janitorial","Disinfection & Sanitization","Floor Care","Day Porter Services","Facility Maintenance","Post-Construction Cleanup"],"numberOfEmployees":{"@type":"QuantitativeValue","minValue":80},"naics":"561720"}0:["zD84zgCHYzEIZPbtDt1yS",[[["",{"children":["blog",{"children":[["slug","prevailing-wage-government-cleaning-contracts","d"],{"children":["__PAGE__?{\"slug\":\"prevailing-wage-government-cleaning-contracts\"}",{}]}]}]},"$undefined","$undefined",true],["",{"children":["blog",{"children":[["slug","prevailing-wage-government-cleaning-contracts","d"],{"children":["__PAGE__",{},[["$L1",["$","div",null,{"style":{"fontFamily":"'Plus Jakarta Sans', sans-serif","background":"#FFFFFF"},"children":[["$","style",null,{"children":"\n        .blog-link { color: #1B7A3D; text-decoration: underline; text-underline-offset: 2px; }\n        .blog-link:hover { color: #16683A; }\n        .blog-related:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.08); }\n      "}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"Prevailing Wage Requirements for Government Cleaning Contracts\",\"description\":\"How federal and state prevailing wage laws affect government cleaning contracts — Davis-Bacon, state little Davis-Bacon acts, Service Contract Act, and their impact on pricing and compliance.\",\"datePublished\":\"2025-07-21\",\"author\":{\"@type\":\"Organization\",\"name\":\"GreenPoint Maintenance Services Corp\",\"url\":\"https://greenpointms.com\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"GreenPoint Maintenance Services Corp\",\"url\":\"https://greenpointms.com\"},\"mainEntityOfPage\":\"https://greenpointms.com/blog/prevailing-wage-government-cleaning-contracts/\",\"keywords\":\"prevailing wage cleaning contract, Davis-Bacon janitorial, Service Contract Act cleaning\"}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://greenpointms.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Blog\",\"item\":\"https://greenpointms.com/blog/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Prevailing Wage Requirements for Government Cleaning Contracts\"}]}"}}],["$","$L2",null,{}],["$","section",null,{"style":{"background":"#0A2A16","paddingTop":140,"paddingBottom":64,"position":"relative","overflow":"hidden"},"children":[["$","div",null,{"style":{"position":"absolute","inset":0,"opacity":0.04,"backgroundImage":"linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px)","backgroundSize":"60px 60px","pointerEvents":"none"}}],["$","div",null,{"style":{"maxWidth":720,"margin":"0 auto","padding":"0 24px","position":"relative","zIndex":1},"children":[["$","nav",null,{"style":{"display":"flex","gap":8,"alignItems":"center","marginBottom":24,"flexWrap":"wrap"},"children":[["$","a",null,{"href":"/","style":{"fontFamily":"'JetBrains Mono', monospace","fontSize":11,"color":"rgba(255,255,255,0.4)","textDecoration":"none","fontWeight":600,"letterSpacing":"0.05em"},"children":"Home"}],["$","span",null,{"style":{"color":"rgba(255,255,255,0.2)","fontSize":12},"children":"›"}],["$","a",null,{"href":"/blog/","style":{"fontFamily":"'JetBrains Mono', monospace","fontSize":11,"color":"rgba(255,255,255,0.4)","textDecoration":"none","fontWeight":600,"letterSpacing":"0.05em"},"children":"Blog"}],["$","span",null,{"style":{"color":"rgba(255,255,255,0.2)","fontSize":12},"children":"›"}],["$","span",null,{"style":{"fontFamily":"'JetBrains Mono', monospace","fontSize":11,"color":"#C8A34D","fontWeight":600,"letterSpacing":"0.05em"},"children":"Compliance"}]]}],["$","div",null,{"style":{"display":"flex","alignItems":"center","gap":12,"marginBottom":20,"flexWrap":"wrap"},"children":[["$","span",null,{"style":{"background":"rgba(200,163,77,0.15)","color":"#C8A34D","padding":"4px 10px","borderRadius":4,"fontSize":11,"fontWeight":600,"fontFamily":"'JetBrains Mono', monospace","letterSpacing":"0.05em"},"children":"Compliance"}],["$","span",null,{"style":{"fontSize":12,"color":"rgba(255,255,255,0.4)","fontFamily":"'JetBrains Mono', monospace"},"children":"July 21, 2025"}],["$","span",null,{"style":{"fontSize":12,"color":"rgba(255,255,255,0.4)","fontFamily":"'JetBrains Mono', monospace"},"children":["· ","8 min read"]}]]}],["$","h1",null,{"style":{"fontFamily":"'Syne', sans-serif","fontSize":"clamp(28px, 4vw, 42px)","fontWeight":700,"color":"#fff","lineHeight":1.15,"marginBottom":0,"letterSpacing":"-0.02em"},"children":"Prevailing Wage Requirements for Government Cleaning Contracts"}]]}]]}],"$undefined",["$","article",null,{"style":{"maxWidth":720,"margin":"0 auto","padding":"48px 24px 64px"},"children":[[["$","p","0",{"style":{"fontSize":18,"color":"#1A2B1F","lineHeight":1.8,"marginBottom":32,"fontWeight":500},"children":"Prevailing wage laws are among the most misunderstood requirements in government cleaning contracts. These laws require that workers on government contracts be paid a minimum wage rate determined by the Department of Labor — typically significantly higher than market wages. Non-compliance can result in contract termination, back-pay liability, debarment from future contracts, and even criminal penalties. This guide explains how prevailing wage requirements apply to commercial cleaning contracts."}],["$","h2","1",{"style":{"fontFamily":"'Syne', sans-serif","fontSize":22,"fontWeight":700,"color":"#1A2B1F","lineHeight":1.25,"marginTop":40,"marginBottom":16,"letterSpacing":"-0.01em"},"children":"The Service Contract Act (Federal)"}],["$","p","2",{"style":{"fontSize":16,"color":"#4A5E52","lineHeight":1.8,"marginBottom":20},"children":"The McNamara-O'Hara Service Contract Act (SCA) applies to federal contracts over $2,500 for services, including janitorial and cleaning services. The SCA requires contractors to pay employees no less than the prevailing wage rates determined by the Department of Labor's Wage and Hour Division for the locality where services are performed. For janitorial workers, SCA wage determinations typically range from $15-$25 per hour depending on location, plus fringe benefits (health and welfare, vacation, holidays) that add $4-$8 per hour. The SCA also requires contractors to provide safe and sanitary working conditions and prohibits wage rate reductions during the contract term."}],["$","h2","3",{"style":{"fontFamily":"'Syne', sans-serif","fontSize":22,"fontWeight":700,"color":"#1A2B1F","lineHeight":1.25,"marginTop":40,"marginBottom":16,"letterSpacing":"-0.01em"},"children":"State Prevailing Wage Laws"}],["$","p","4",{"style":{"fontSize":16,"color":"#4A5E52","lineHeight":1.8,"marginBottom":20},"children":"Many states have their own prevailing wage laws (sometimes called 'little Davis-Bacon' or 'little SCA' acts) that apply to state and local government contracts. New York, New Jersey, Connecticut, and Pennsylvania — GreenPoint's primary service states — all have prevailing wage requirements. New York's prevailing wage rates for building service workers in NYC metro are among the highest in the nation. These state laws often apply at lower contract thresholds than federal requirements and may cover additional worker classifications. Contractors must comply with whichever law — federal or state — provides the higher wage rate."}],["$","h2","5",{"style":{"fontFamily":"'Syne', sans-serif","fontSize":22,"fontWeight":700,"color":"#1A2B1F","lineHeight":1.25,"marginTop":40,"marginBottom":16,"letterSpacing":"-0.01em"},"children":"Impact on Contract Pricing"}],["$","p","6",{"style":{"fontSize":16,"color":"#4A5E52","lineHeight":1.8,"marginBottom":20},"children":"Prevailing wage requirements typically increase cleaning contract costs by 30-60% compared to private sector contracts for equivalent scope. This premium reflects higher hourly wages (often $18-$28/hr vs. $15-$18/hr market rate), mandatory fringe benefits ($4-$8/hr additional), and compliance overhead including certified payroll reporting, poster requirements, and record-keeping. Facility managers evaluating government cleaning proposals should expect prices significantly above private-market benchmarks — bids that appear at private-market rates may indicate a contractor who is not actually paying prevailing wages, creating significant liability risk for the contracting agency."}],["$","h2","7",{"style":{"fontFamily":"'Syne', sans-serif","fontSize":22,"fontWeight":700,"color":"#1A2B1F","lineHeight":1.25,"marginTop":40,"marginBottom":16,"letterSpacing":"-0.01em"},"children":"Compliance Requirements"}],["$","p","8",{"style":{"fontSize":16,"color":"#4A5E52","lineHeight":1.8,"marginBottom":20},"children":"Prevailing wage compliance involves certified payroll submissions (weekly under Davis-Bacon, as required under SCA), posting wage determination rates at the worksite, maintaining accurate time records showing hours worked by classification, paying fringe benefits either directly or to bona fide benefit plans, complying with anti-kickback provisions, and making records available for DOL investigation. The most common compliance failures are misclassification of workers (using a lower-paid classification for higher-classification work), inadequate fringe benefit payments, and incomplete certified payroll records."}],["$","div","9",{"style":{"background":"#F0F7F2","borderLeft":"3px solid #1B7A3D","padding":"20px 24px","borderRadius":"0 8px 8px 0","margin":"32px 0"},"children":["$","p",null,{"style":{"fontSize":15,"color":"#1A2B1F","lineHeight":1.7,"fontWeight":500,"margin":0},"children":"GreenPoint has extensive experience with prevailing wage government contracts across NY, NJ, CT, and PA. Our pricing transparently reflects prevailing wage requirements, and our payroll systems produce compliant certified payroll reports. As an MBE-certified contractor registered on SAM.gov, we combine diversity procurement advantages with prevailing wage compliance expertise."}]}]],["$","div",null,{"style":{"borderTop":"1px solid #E2EBE5","marginTop":48,"paddingTop":32,"display":"flex","flexDirection":"column","gap":16},"children":[["$","div",null,{"style":{"display":"flex","alignItems":"center","gap":14},"children":[["$","div",null,{"style":{"width":48,"height":48,"borderRadius":8,"background":"#1B7A3D","display":"flex","alignItems":"center","justifyContent":"center","color":"#fff","fontWeight":800,"fontFamily":"'Syne', sans-serif","fontSize":20},"children":"G"}],["$","div",null,{"children":[["$","div",null,{"style":{"fontWeight":600,"color":"#1A2B1F","fontSize":15},"children":"GreenPoint Maintenance Services"}],["$","div",null,{"style":{"fontSize":13,"color":"#8A9B91"},"children":"MBE-Certified Commercial Cleaning · NY, NJ, CT, PA, FL"}]]}]]}],["$","a",null,{"href":"/#schedule","style":{"display":"inline-flex","alignItems":"center","gap":8,"background":"#1B7A3D","color":"#fff","padding":"12px 24px","borderRadius":8,"fontWeight":700,"fontSize":13,"textDecoration":"none","fontFamily":"'Syne', sans-serif","letterSpacing":"0.04em","alignSelf":"flex-start"},"children":"Schedule a Free Walkthrough →"}]]}]]}],["$","section",null,{"style":{"background":"#F7FAF8","padding":"64px 24px","borderTop":"1px solid #E2EBE5"},"children":["$","div",null,{"style":{"maxWidth":900,"margin":"0 auto"},"children":[["$","div",null,{"style":{"display":"flex","alignItems":"center","gap"