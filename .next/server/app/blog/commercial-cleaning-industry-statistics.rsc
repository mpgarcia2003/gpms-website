"}]]}],["$","a","janitorial-employee-turnover-impact",{"href":"/blog/janitorial-employee-turnover-impact/","className":"blog-related","style":{"display":"block","textDecoration":"none","background":"#FFFFFF","borderRadius":10,"border":"1px solid #E2EBE5","padding":20,"transition":"transform 0.2s ease, box-shadow 0.2s ease"},"children":[["$","span",null,{"style":{"fontSize":11,"color":"#8A9B91","fontFamily":"'JetBrains Mono', monospace","fontWeight":600},"children":"Industry Data"}],["$","h4",null,{"style":{"fontFamily":"'Syne', sans-serif","fontSize":16,"fontWeight":700,"color":"#1A2B1F","lineHeight":1.3,"margin":"8px 0 8px","letterSpacing":"-0.01em"},"children":"The Hidden Cost of Janitorial Turnover: Why Your Cleaning Company's Retention Rate Matters"}],["$","span",null,{"style":{"fontSize":12,"color":"#1B7A3D","fontWeight":600},"children":"Read →"}]]}]]}]]}]}],["$","$L3",null,{}]]}],null],null],null]},[null,["$","$L4",null,{"parallelRouterKey":"children","segmentPath":["children","blog","children","$5","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L6",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L4",null,{"parallelRouterKey":"children","segmentPath":["children","blog","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L6",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/c38ae2967d26df17.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","children":[["$","head",null,{"children":[["$","script",null,{"async":true,"src":"https://www.googletagmanager.com/gtag/js?id=G-6378ZM1RKQ"}],["$","script",null,{"dangerouslySetInnerHTML":{"__html":"\n              window.dataLayer = win