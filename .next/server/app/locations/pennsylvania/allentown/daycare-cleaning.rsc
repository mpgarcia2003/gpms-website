2:T772,{"@context":"https://schema.org","@type":"LocalBusiness","name":"GreenPoint Maintenance Services - Allentown","description":"Daycare and childcare center cleaning refers to the specialized sanitization services required for facilities caring for infants, toddlers, and young children. This cleaning category demands the highest standards of any commercial environment: exclusively non-toxic, EPA Safer Choice or Green Seal certified products; sanitization of toys, play surfaces, changing stations, and nap areas at frequencies that meet state health department licensing requirements; and documented cleaning protocols that satisfy both regulatory inspectors and parent expectations for visible proof of cleanliness. GreenPoint Maintenance Services provides MBE-certified daycare cleaning in Allentown and throughout Pennsylvania with real-time ATP bioluminescence verification through JaniTrack.","url":"https://greenpointms.com/locations/pennsylvania/allentown/daycare-cleaning/","telephone":"+1-347-332-9348","email":"info@greenpointms.com","areaServed":{"@type":"City","name":"Allentown","containedInPlace":{"@type":"State","name":"Pennsylvania"}},"serviceType":"Daycare & Childcare Centers","priceRange":"$","hasOfferCatalog":{"@type":"OfferCatalog","name":"Daycare Cleaning Services","itemListElement":[{"@type":"Offer","itemOffered":{"@type":"Service","name":"Non-toxic, child-safe products exclusively"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Toy and play surface sanitization"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Nap room and changing station protocols"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Health department compliance cleaning"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Indoor play area deep sanitization"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Staff break room and kitchen cleaning"}}]}}3:Tee5,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is professional daycare cleaning?","acceptedAnswer":{"@type":"Answer","text":"Professional daycare cleaning is specialized sanitization service for childcare facilities that uses exclusively non-toxic, EPA Safer Choice or Green Seal certified products to sanitize infant rooms, toddler areas, play surfaces, changing stations, kitchens, and restrooms to health department licensing standards. It differs from standard commercial cleaning in its product requirements (zero toxicity), frequency demands (multiple daily sanitizations), and documentation standards (inspector-ready records)."}},{"@type":"Question","name":"What products do you use in daycare facilities?","acceptedAnswer":{"@type":"Answer","text":"We exclusively use EPA Safer Choice and Green Seal certified products that are non-toxic, fragrance-free, dye-free, and specifically approved for environments where infants and toddlers are present. These products eliminate pathogens effectively while containing zero VOCs, zero fragrances, and zero chemical irritants. We never substitute conventional products regardless of availability — child safety is non-negotiable."}},{"@type":"Question","name":"How do you sanitize toys and play equipment?","acceptedAnswer":{"@type":"Answer","text":"Toys and play surfaces are sanitized using child-safe disinfectants applied with appropriate dwell times (the time the product must remain wet on the surface to be effective). We follow state health department guidelines for toy sanitization frequency: daily for mouthed toys and manipulatives, weekly for larger equipment and non-mouthed materials. Outdoor play equipment receives periodic sanitization on a scheduled basis."}},{"@type":"Question","name":"Will you help us pass health department inspections?","acceptedAnswer":{"@type":"Answer","text":"Yes. Our cleaning protocols are designed specifically to meet and exceed state health department standards for childcare facilities. We address the five most common inspection citations: changing station sanitization, chemical storage compliance, cleaning documentation, food surface sanitization, and toy cleaning frequency. Many of our daycare clients report improved inspection scores within the first inspection cycle after switching to GreenPoint."}},{"@type":"Question","name":"Can parents see proof of cleaning?","acceptedAnswer":{"@type":"Answer","text":"Yes. Our JaniTrack system generates photo-verified cleaning reports with timestamped documentation of every sanitization session. Facility directors can share these reports with parents through email, parent portals, or printed summaries — providing transparent proof of daily sanitization that builds trust and supports enrollment conversations."}},{"@type":"Question","name":"How much does daycare cleaning cost?","acceptedAnswer":{"@type":"Answer","text":"Daycare cleaning typically ranges from $0.10-$0.22 per square foot per cleaning visit due to the specialized products, higher sanitization frequency, and documentation requirements. A typical 5,000 sq ft daycare center cleaned daily runs approximately $2,500-$5,000 per month. Pricing reflects the premium products and intensive protocols required — this is not an area where cost-cutting produces acceptable results."}},{"@type":"Question","name":"Do you clean during operating hours?","acceptedAnswer":{"@type":"Answer","text":"Professional deep cleaning is performed after hours when children are not present. However, we can provide daytime support through day porter services for restroom monitoring, spill response, and cafeteria turnovers during operating hours. All daytime staff undergo the same background checks and child-safety training as our after-hours crews."}}]}6:["stateSlug","pennsylvania","d"]
7:["citySlug","allentown","d"]
8:["industrySlug","daycare-cleaning","d"]
a:T5d4,{"@context":"https://schema.org","@type":"LocalBusiness","name":"GreenPoint Maintenance Services Corp","description":"MBE-certified commercial janitorial and facility maintenance for schools, healthcare, churches, daycare, government buildings, and offices across NY, NJ, CT, PA, and FL.","url":"https://greenpointms.com","telephone":"+1-347-332-9348","email":"info@greenpointms.com","address":{"@type":"PostalAddress","addressLocality":"Bronx","addressRegion":"NY","addressCountry":"US"},"areaServed":[{"@type":"State","name":"New York"},{"@type":"State","name":"New Jersey"},{"@type":"State","name":"Connecticut"},{"@type":"State","name":"Pennsylvania"},{"@type":"State","name":"Florida"}],"priceRange":"$","foundingDate":"2018","numberOfEmployees":{"@type":"QuantitativeValue","minValue":80},"naics":"561720","knowsAbout":["Commercial Janitorial","Disinfection","Floor Care","Day Porter","Facility Maintenance","Post-Construction Cleanup"],"hasCredential":[{"@type":"EducationalOccupationalCredential","credentialCategory":"certification","name":"Minority Business Enterprise (MBE) — NYC & NYS"},{"@type":"EducationalOccupationalCredential","credentialCategory":"certification","name":"MWBE Certified"},{"@type":"EducationalOccupationalCredential","credentialCategory":"registration","name":"SAM.gov Registered Federal Contractor"},{"@type":"EducationalOccupationalCredential","credentialCategory":"certification","name":"NYC Department of Education (DOE) Approved Vendor"}],"sameAs":[]}b:T452,{"@context":"https://schema.org","@type":"Organization","name":"GreenPoint Maintenance Services Corp","legalName":"GreenPoint Maintenance Services Corp","url":"https://greenpointms.com","logo":"https://greenpointms.com/favicon.ico","description":"MBE-certified commercial janitorial and facility maintenance serving schools, healthcare, churches, daycare, government buildings, and offices across NY, NJ, CT, PA, and FL.","telephone":"+1-347-332-9348","email":"info@greenpointms.com","foundingDate":"2018","address":{"@type":"PostalAddress","streetAddress":"1420 Outlook Ave","addressLocality":"Bronx","addressRegion":"NY","postalCode":"10465","addressCountry":"US"},"areaServed":[{"@type":"State","name":"New York"},{"@type":"State","name":"New Jersey"},{"@type":"State","name":"Connecticut"},{"@type":"State","name":"Pennsylvania"},{"@type":"State","name":"Florida"}],"knowsAbout":["Commercial Janitorial","Disinfection & Sanitization","Floor Care","Day Porter Services","Facility Maintenance","Post-Construction Cleanup"],"numberOfEmployees":{"@type":"QuantitativeValue","minValue":80},"naics":"561720"}0:["zD84zgCHYzEIZPbtDt1yS",[[["",{"children":["locations",{"children":[["stateSlug","pennsylvania","d"],{"children":[["citySlug","allentown","d"],{"children":[["industrySlug","daycare-cleaning","d"],{"children":["__PAGE__?{\"stateSlug\":\"pennsylvania\",\"citySlug\":\"allentown\",\"industrySlug\":\"daycare-cleaning\"}",{}]}]}]}]}]},"$undefined","$undefined",true],["",{"children":["locations",{"children":[["stateSlug","pennsylvania","d"],{"children":[["citySlug","allentown","d"],{"children":[["industrySlug","daycare-cleaning","d"],{"children":["__PAGE__",{},[["$L1",[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://greenpointms.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Pennsylvania\",\"item\":\"https://greenpointms.com/locations/pennsylvania/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Allentown\",\"item\":\"https://greenpointms.com/locations/pennsylvania/allentown/\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"Daycare Cleaning\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$3"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"name\":\"Daycare Cleaning in Allentown, PA\",\"description\":\"Specialized cleaning for infant rooms, toddler areas, and play spaces using exclusively non-toxic, eco-friendly products approved for environments with children.\",\"provider\":{\"@type\":\"LocalBusiness\",\"name\":\"GreenPoint Maintenance Services Corp\",\"telephone\":\"+1-347-332-9348\",\"url\":\"https://greenpointms.com\"},\"areaServed\":{\"@type\":\"City\",\"name\":\"Allentown\",\"containedInPlace\":{\"@type\":\"State\",\"name\":\"Pennsylvania\"}},\"serviceType\":\"Daycare & Childcare Centers\"}"}}],["$","$L4",null,{"title":["Daycare Cleaning"," Services in ","Allentown",", ",["$","span",null,{"style":{"color":"#2ecc71"},"children":"PA"}]],"subtitle":"Daycare and childcare center cleaning refers to the specialized sanitization services required for facilities caring for infants, toddlers, and young children. This cleaning category demands the highest standards of any commercial environment: exclusively non-toxic, EPA Safer Choice or Green Seal certified products; sanitization of toys, play surfaces, changing stations, and nap areas at frequencies that meet state health department licensing requirements; and documented cleaning protocols that satisfy both regulatory inspectors and parent expectations for visible proof of cleanliness. GreenPoint Maintenance Services provides MBE-certified daycare cleaning in Allentown and throughout Pennsylvania with real-time ATP bioluminescence verification through JaniTrack.","breadcrumbs":[{"label":"Pennsylvania","href":"/locations/pennsylvania/"},{"label":"Allentown","href":"/locations/pennsylvania/allentown/"},{"label":"Daycare Cleaning"}],"heroIcon":"baby","sections":[{"label":"What Is Daycare Cleaning","heading":"Daycare & Childcare Centers in Allentown, PA","body":"Daycare and childcare center cleaning refers to the specialized sanitization services required for facilities caring for infants, toddlers, and young children. This cleaning category demands the highest standards of any commercial environment: exclusively non-toxic, EPA Safer Choice or Green Seal certified products; sanitization of toys, play surfaces, changing stations, and nap areas at frequencies that meet state health department licensing requirements; and documented cleaning protocols that satisfy both regulatory inspectors and parent expectations for visible proof of cleanliness.\n\nGreenPoint Maintenance Services provides professional daycare cleaning services throughout Allentown and Lehigh County. As an MBE-certified commercial cleaning company serving Pennsylvania since 2018, we combine EPA-registered products, electrostatic application technology, and ATP bioluminescence verification to deliver measurable, documented results for every facility we serve.","features":["Non-toxic, child-safe products exclusively","Toy and play surface sanitization","Nap room and changing station protocols","Health department compliance cleaning","Indoor play area deep sanitization","Staff break room and kitchen cleaning"]},{"label":"Why Allentown Businesses Need Daycare Cleaning","heading":"Why Businesses in Allentown Need Professional Daycare Cleaning","body":"Facilities in Allentown, PA face increasing pressure to maintain safe, hygienic environments for employees, customers, students, and patients. Professional daycare cleaning addresses these requirements systematically.","features":["Protecting the most vulnerable population — infants and toddlers have developing immune systems and explore their environment orally, making sanitized surfaces literally a matter of child health and safety","Maintaining state childcare licensing — health department inspections evaluate sanitization frequency, product safety, changing station protocols, and documentation. Failed inspections can result in temporary closure and permanent reputation damage","Eliminating toxic chemical exposure — conventional cleaning products contain VOCs, fragrances, and chemical irritants that cause respiratory issues, skin reactions, and allergic responses in children at rates 3-5x higher than adults","Satisfying parent expectations — parents consistently rank facility cleanliness as their number one concern when selecting and evaluating childcare providers, and increasingly demand verifiable proof of sanitization","Preventing disease outbreaks — daycare centers experience higher rates of norovirus, hand-foot-mouth disease, and respiratory illness transmission due to close contact, shared surfaces, and developmental behaviors (mouthing objects, inadequate hand hygiene)"]},{"label":"How It Works","heading":"How Professional Daycare Cleaning Works","body":"Our daycare cleaning process follows a systematic, six-step protocol designed to maximize pathogen elimination and provide verifiable documentation of results. Every step is performed by trained, background-checked technicians.","steps":[{"step":"Infant Room Sanitization","detail":"Cribs, changing tables, rocking chairs, and floor surfaces are sanitized using EPA Safer Choice products with zero fragrance and zero irritant potential. Floor-level sanitization receives extra attention because infants spend significant time on the floor and put objects in their mouths."},{"step":"Toy and Play Surface Treatment","detail":"All toys, manipulatives, play tables, and shared materials are sanitized using child-safe disinfectants with appropriate dwell times. We follow state health department guidelines for toy rotation frequency — typically daily for mouthed toys and weekly for non-mouthed materials."},{"step":"Changing Station Protocol","detail":"Diaper changing stations are sanitized after every use by daycare staff during the day. Our professional cleaning provides end-of-day deep sanitization of the changing surface, surrounding areas, waste receptacles, and supply storage to eliminate bacterial accumulation."},{"step":"Kitchen and Food Prep Areas","detail":"Food preparation surfaces, high chairs, feeding tables, bottle preparation areas, and food storage zones are sanitized using products that meet both food-contact surface requirements and child-safe certification standards."},{"step":"Restroom and Potty Training Areas","detail":"Child-height toilets, training potties, sinks, and surrounding floor areas receive intensive sanitization with particular attention to splash zones and high-touch surfaces. These areas require the highest disinfection frequency in the facility."},{"step":"Documentation for Inspections","detail":"Every cleaning session is documented through JaniTrack with timestamped photos, product documentation, and task completion records. This creates the exact documentation trail that health department inspectors require and that facility directors can share with parents on request."}]},{"label":"Industries in Allentown","heading":"Industries That Require Daycare Cleaning in Allentown","body":"We deliver specialized daycare cleaning services across every commercial and institutional facility type in Allentown and throughout Lehigh County. Each industry receives protocols tailored to its specific compliance requirements, risk profile, and operational constraints.","industriesServed":[{"name":"Infant Care Centers (0-12 months)","detail":"The most sanitization-intensive environment in childcare — crib sanitization, floor-level cleaning for non-mobile infants, bottle preparation area maintenance, and exclusively fragrance-free products for developing respiratory systems."},{"name":"Toddler Programs (1-3 years)","detail":"High-frequency toy sanitization for the age group most actively mouthing objects, changing station deep cleaning, active play area maintenance, and nap room crib/mat sanitization between children."},{"name":"Preschool Programs (3-5 years)","detail":"Classroom sanitization including art stations, learning centers, shared materials, bathroom training areas, and cafeteria surfaces with products that are both effective and safe for supervised independent use areas."},{"name":"After-School Programs","detail":"Evening cleaning for programs operating in school facilities or dedicated spaces, with turnaround cleaning between school dismissal and program start and end-of-program deep cleaning."},{"name":"Church-Based Childcare","detail":"Nursery and childcare rooms within houses of worship that must meet health department standards when providing regular childcare services, with flexible scheduling around worship service times."},{"name":"Home-Based Childcare Networks","detail":"Periodic professional deep cleaning for licensed home-based childcare providers who need commercial-grade sanitization support for health department licensing compliance."}]},{"label":"Key Benefits","heading":"Key Benefits of Professional Daycare Cleaning","body":"Benefits of professional daycare cleaning for commercial facilities in Allentown include:","features":["Exclusively non-toxic, EPA Safer Choice and Green Seal certified products — zero fragrance, zero irritants, zero harmful chemicals in environments where children are present","Health department inspection readiness through documented cleaning protocols, product certifications, and JaniTrack verification reports","Reduced illness transmission through systematic sanitization of the surfaces, toys, and equipment that serve as transmission vectors in childcare environments","Parent-shareable cleaning reports through JaniTrack that provide transparent proof of daily sanitization — building trust and supporting enrollment retention","Background-checked, trained crews who understand the unique requirements and responsibilities of working in environments with young children","Compliance with state-specific childcare licensing requirements across all five states we serve (NY, NJ, CT, PA, FL), each with distinct regulatory standards"]},{"label":"FAQ","heading":"Daycare Cleaning FAQ — Allentown, PA","body":"Common questions about daycare cleaning services in Allentown.","faqs":[{"q":"What is professional daycare cleaning?","a":"Professional daycare cleaning is specialized sanitization service for childcare facilities that uses exclusively non-toxic, EPA Safer Choice or Green Seal certified products to sanitize infant rooms, toddler areas, play surfaces, changing stations, kitchens, and restrooms to health department licensing standards. It differs from standard commercial cleaning in its product requirements (zero toxicity), frequency demands (multiple daily sanitizations), and documentation standards (inspector-ready records)."},{"q":"What products do you use in daycare facilities?","a":"We exclusively use EPA Safer Choice and Green Seal certified products that are non-toxic, fragrance-free, dye-free, and specifically approved for environments where infants and toddlers are present. These products eliminate pathogens effectively while containing zero VOCs, zero fragrances, and zero chemical irritants. We never substitute conventional products regardless of availability — child safety is non-negotiable."},{"q":"How do you sanitize toys and play equipment?","a":"Toys and play surfaces are sanitized using child-safe disinfectants applied with appropriate dwell times (the time the product must remain wet on the surface to be effective). We follow state health department guidelines for toy sanitization frequency: daily for mouthed toys and manipulatives, weekly for larger equipment and non-mouthed materials. Outdoor play equipment receives periodic sanitization on a scheduled basis."},{"q":"Will you help us pass health department inspections?","a":"Yes. Our cleaning protocols are designed specifically to meet and exceed state health department standards for childcare facilities. We address the five most common inspection citations: changing station sanitization, chemical storage compliance, cleaning documentation, food surface sanitization, and toy cleaning frequency. Many of our daycare clients report improved inspection scores within the first inspection cycle after switching to GreenPoint."},{"q":"Can parents see proof of cleaning?","a":"Yes. Our JaniTrack system generates photo-verified cleaning reports with timestamped documentation of every sanitization session. Facility directors can share these reports with parents through email, parent portals, or printed summaries — providing transparent proof of daily sanitization that builds trust and supports enrollment conversations."},{"q":"How much does daycare cleaning cost?","a":"Daycare cleaning typically ranges from $0.10-$0.22 per square foot per cleaning visit due to the specialized products, higher sanitization frequency, and documentation requirements. A typical 5,000 sq ft daycare center cleaned daily runs approximately $2,500-$5,000 per month. Pricing reflects the premium products and intensive protocols required — this is not an area where cost-cutting produces acceptable results."},{"q":"Do you clean during operating hours?","a":"Professional deep cleaning is performed after hours when children are not present. However, we can provide daytime support through day porter services for restroom monitoring, spill response, and cafeteria turnovers during operating hours. All daytime staff undergo the same background checks and child-safety training as our after-hours crews."}]},{"label":"Why GreenPoint","heading":"Why Allentown Facilities Trust GreenPoint for Daycare Cleaning","body":"GreenPoint Maintenance Services is an MBE/MWBE-certified, NYC DOE Approved Vendor serving over 500 commercial facilities across Pennsylvania and four additional states. Our JaniTrack verification system provides the objective, documented proof of cleaning quality that facility managers, health inspectors, and building occupants demand.","stats":[{"number":"98%","label":"Client Retention"},{"number":"500+","label":"Facilities Served"},{"number":"5","label":"States Covered"},{"number":"MBE","label":"Certified"}]}],"relatedLinks":[{"href":"/locations/pennsylvania/allentown/school-cleaning/","label":"School Cleaning in Allentown","icon":"school"},{"href":"/locations/pennsylvania/allentown/church-cleaning/","label":"Church Cleaning in Allentown","icon":"church"},{"href":"/locations/pennsylvania/allentown/medical-office-cleaning/","label":"Medical Office Cleaning in Allentown","icon":"medical"},{"href":"/locations/pennsylvania/allentown/government-building-cleaning/","label":"Government Cleaning in Allentown","icon":"landmark"},{"href":"/locations/pennsylvania/allentown/office-cleaning/","label":"Office Cleaning in Allentown","icon":"building"},{"href":"/locations/pennsylvania/philadelphia/daycare-cleaning/","label":"Daycare Cleaning in Philadelphia","icon":"baby"},{"href":"/locations/pennsylvania/scranton/daycare-cleaning/","label":"Daycare Cleaning in Scranton","icon":"baby"},{"href":"/locations/pennsylvania/bethlehem/daycare-cleaning/","label":"Daycare Cleaning in Bethlehem","icon":"baby"},{"href":"/locations/pennsylvania/reading/daycare-cleaning/","label":"Daycare Cleaning in Reading","icon":"baby"},{"href":"/locations/pennsylvania/king-of-prussia/daycare-cleaning/","label":"Daycare Cleaning in King of Prussia","icon":"baby"}]}]],null],null],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","locations","children","$6","children","$7","children","$8","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L9",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","locations","children","$6","children","$7","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L9",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","locations","children","$6","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L9",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","locations","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L9",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/c38ae2967d26df17.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","children":[["$","head",null,{"children":[["$","script",null,{"async":true,"src":"https://www.googletagmanager.com/gtag/js?id=G-6378ZM1RKQ"}],["$","script",null,{"dangerouslySetInnerHTML":{"__html":"\n              window.dataLayer = window.dataLayer || [];\n              function gtag(){dataLayer.push(arguments);}\n              gtag('js', new Date());\n              gtag('config', 'G-6378ZM1RKQ');\n            "}}],["$","link",null,{"rel":"preconnect","href":"https://fonts.googleapis.com"}],["$","link",null,{"rel":"preconnect","href":"https://fonts.gstatic.com","crossOrigin":"anonymous"}],["$","link",null,{"href":"https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap","rel":"stylesheet"}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$a"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$b"}}]]}],["$","body",null,{"style":{"margin":0,"padding":0,"fontFamily":"'Plus Jakarta Sans', sans-