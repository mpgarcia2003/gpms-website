lor":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Report any damaged or malfunctioning equipment to Miguel Garcia immediately. Tag out damaged equipment so no one else uses it."]}],["$","li","3",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Never modify, disassemble, or bypass safety guards on any equipment."]}],["$","li","4",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Unplug equipment before changing bags, brushes, filters, or clearing jams."]}],["$","li","5",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Do not run cords across walkways without proper cord covers or tape."]}],["$","li","6",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Do not use electrical equipment in wet conditions unless it is rated for wet use."]}],["$","li","7",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Return all equipment to its designated storage area clean, coiled, and ready for the next user."]}]]}]}],["$","style",null,{"children":"\n        #section-8 p { margin: 0 0 14px 0; }\n        #section-8 p:last-child { margin-bottom: 0; }\n        #section-8 ul { margin: 0 0 14px 0; padding-left: 0; list-style: none; }\n        #section-8 ol { margin: 0 0 14px 0; }\n      "}]]}],["$","div",null,{"style":{"marginBottom":36,"scrollMarginTop":100},"id":"section-9","children":[["$","h2",null,{"style":{"fontFamily":"'Playfair Display', Georgia, serif","fontSize":22,"fontWeight":700,"color":"#0d2818","marginBottom":14,"display":"flex","alignItems":"baseline","gap":12,"flexWrap":"wrap"},"children":[["$","span",null,{"style":{"fontFamily":"'JetBrains Mono', monospace","fontSize":13,"color":"#C8A34D","fontWeight":700,"letterSpacing":"0.05em"},"children":["§","9"]}],["$","span",null,{"children":"Phone & Personal Device Policy"}],["$","span",null,{"style":{"background":"rgba(200,163,77,0.12)","color":"#8a6d2a","padding":"2px 8px","borderRadius":4,"fontSize":10,"fontWeigh