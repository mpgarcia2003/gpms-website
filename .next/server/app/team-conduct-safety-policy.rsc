e":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Only authorized Team Members may operate Company vehicles. You must hold a valid driver's license and provide a copy to Miguel Garcia before driving."]}],["$","li","1",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Seat belts must be worn at all times — driver and all passengers. No exceptions."]}],["$","li","2",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"No phone use while driving, including hands-free calls for anything other than brief essential communication. No texting, emailing, navigating via handheld, or social media while the vehicle is moving."]}],["$","li","3",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"No passengers other than GreenPoint Team Members in Company vehicles without written authorization."]}],["$","li","4",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"No smoking, vaping, eating, or drinking anything other than water while driving."]}],["$","li","5",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Obey all posted speed limits. Leave early enough that you never have to rush."]}],["$","li","6",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Inspect the vehicle before each shift — tires, lights, fluids, mirrors. Report any issues to Miguel Garcia before driving."]}],["$","li","7",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Report any vehicle accident — regardless of fault or apparent damage — to Miguel Garcia within two (2) hours. All Company vehicle accidents are also subject to the injury reporting rule in Section 3."]}],["$","li","8",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Keep vehicles clean and organized. Secure all supplies, chemicals, and equipment so they do not shift during transit."]}]]}]}],["$","style",null,{"children":"\n        #section-10 p { margin: 0 0 14px 0; }\n        #section-10 p:last-child { margin-bottom: 0; }\n        #section-10 ul { margin: 0 0 14px 0; padding-left: 0; list-style: none; }\n        #section-10 ol { margin: 0 0 14px 0; }\n      "}]]}],["$","div",null,{"style":{"marginBottom":36,"scrollMarginTop":100},"id":"section-11","children":[["$","h2",null,{"style":{"fontFamily":"'Playfair Display', Georgia, serif","fontSize":22,"fontWeight":700,"color":"#0d2818","marginBottom":14,"display":"flex","alignItems":"baseline","gap":12,"flexWrap":"wrap"},"children":[["$","span",null,{"style":{"fontFamily":"'JetBrains Mono', monospace","fontSize":13,"color":"#1B7A3D","fontWeight":700,"letterSpacing":"0.05em"},"children":["§","11"]}],["$","span",null,{"children":"Client Property & Confidentiality"}],"$undefined"]}],["$","div",null,{"style":{"fontSize":15,"color":"#444","lineHeight":1.8},"children":["$","ul",null,{"children":[["$","li","0",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Touch only what is on your assigned cleaning checklist. Do not move, rearrange, or handle personal items, client valuables, paperwork, computers, or electronics unless specifically instructed."]}],["$","li","1",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"If a client item is in the way, clean around it or notify Miguel Garcia for direction. Never move valuables out of the way yourself."]}],["$","li","2",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Do not photograph, video, or share on any platform any client site, client materials, client employees, or work performed."]}],["$","li","3",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Any documents, access codes, keys, badges, or information you encounter at a client site is confidential and must not be discussed outside of work."]}],["$","li","4",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Do not give out any client contact information, address, or security details to anyone outside GreenPoint."]}],["$","li","5",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Report any suspicious activity, unauthorized persons on site, or concerns about site security to Miguel Garcia immediately."]}],["$","li","6",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius"