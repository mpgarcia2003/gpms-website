m":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Do not consume or be under the influence of alcohol, cannabis, or illegal drugs while on duty, in Company vehicles, or at any client site. GreenPoint maintains a drug- and alcohol-free workplace."]}],["$","li","3",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Do not bring weapons of any kind to any client site, Company vehicle, or Company property."]}],["$","li","4",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Never remove anything from a client site that does not belong to you. Taking any item without written authorization is theft and grounds for immediate termination and criminal referral."]}],["$","li","5",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Immediately report any theft, damage, or misconduct observed on site to Miguel Garcia."]}],["$","li","6",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Do not bring unauthorized visitors, friends, family members, or children to any client site."]}],["$","li","7",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Do not eat or drink in client work areas except in designated break areas approved by the client."]}],["$","li","8",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Maintain a professional appearance. No offensive graphics, political slogans, or inappropriate imagery on clothing, bags, or personal items visible to clients."]}]]}]}],["$","style",null,{"children":"\n        #section-1 p { margin: 0 0 14px 0; }\n        #section-1 p:last-child { margin-bottom: 0; }\n        #section-1 ul { margin: 0 0 14px 0; padding-left: 0; list-style: none; }\n        #section-1 ol { margin: 0 0 14px 0; }\n      "}]]}],["$","div",null,{"style":{"marginBottom":36,"scrollMarginTop":100},"id":"section-2","children":[["$","h2",null,{"style":{"fontFamily":"'Playfair Display', Georgia, serif","fontSize":22,"fontWeight":700,"color":"#0d2818","marginBottom":14,"display":"flex","alignItems":"baseline","gap":12,"flexWrap":"wrap"},"children":[["$","span",null,{"style":{"fontFamily":"'JetBrains Mono', monospace","fontSize":13,"color":"#C8A34D","fontWeight":700,"letterSpacing":"0.05em"},"children":["§","2"]}],["$","span",null,{"children":"Ladder Safety — Two-Person Rule"}],["$","span",null,{"style":{"background":"rgba(200,163,77,0.12)","color":"#8a6d2a","padding":"2px 8px","borderRadius":4,"fontSize":10,"fontWeight":700,"fontFamily":"'JetBrains Mono', monospace","letterSpacing":"0.08em","textTransform":"uppercase","border":"1px solid rgba(200,163,77,0.3)"},"children":"Critical"}]]}],["$","div",null,{"style":{"fontSize":15,"color":"#444","lineHeight":1.8},"children":[["$","div",null,{"style":{"background":"rgba(200,163,77,0.08)","border":"1px solid rgba(200,163,77,0.3)","borderLeft":"3px solid #C8A34D","padding":"14px 18px","borderRadius":4,"marginBottom":18,"fontSize":14,"color":"#5a4a20","fontWeight":500},"children":["⚠️ ","This is a zero-tolerance safety policy. No exceptions. No “just this once.”"]}],["$","p",null,{"children":[["$","strong",null,{"children":"(a) Two-Person Requirement."}]," Whenever a ladder is used for any task — including high dusting, light-bulb replacement, window cleaning, filter changes, signage cleaning, or reaching elevated storage — ",["$","strong",null,{"children":"two Team Members must be present at all times"}],". One person climbs and performs the work; the second person holds and stabilizes the ladder at the base and acts as the spotter."]}],["$","p",null,{"children":[["$","strong",null,{"children":"(b) Ladder Inspection."}]," Before each use, inspect the ladder for broken rungs, cracked rails, loose hardware, missing feet, or damaged spreaders. Any defective ladder must be tagged out, removed from service immediately, and reported to Miguel Garcia."]}],["$","p",null,{"children":[["$","strong",null,{"children":"(c) Prohibited Practices."}]," You shall not:"]}],["$","ul",null,{"children":[["$","li","0",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Climb or descend a ladder with tools, buckets, or supplies in your hands — use a tool belt, tether, or have your partner hand items up."]}],["$","li","1",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Stand on the top rung, top cap, or the brace below the top cap."]}],["$","li","2",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Use a ladder on wet, icy, uneven, or unstable surfaces."]}],["$","li","3",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Use a metal ladder near electrical work or energized equipment."]}],["$","li","4",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Use a ladder outdoors in high winds (20+ mph) or thunderstorms."]}],["$","li","5",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Lean sideways while on a ladder — always keep your belt buckle between the rails."]}],["$","li","6",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Use a folding ladder in the unfolded / leaning position."]}],["$","li","7",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Use any ladder model you have not been trained to use."]}],["$","li","8",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Place a ladder in front of an unlocked door without stationing your partner to block entry."]}]]}],["$","p",null,{"children":[["$","strong",null,{"children":"(d) Height Limits."}]," For any task requiring work above ",["$","strong",null,{"children":"10 feet"}],", you must notify Miguel Garcia in advance and use Company-approved fall protection if available. Work above ",["$","strong",null,{"children":"20 feet"}]," requires written supervisor pre-approval and documented fall protection."]}],["$","p",null,{"children":[["$","strong",null,{"children":"(e) No Exceptions."}]," If a second Team Memb