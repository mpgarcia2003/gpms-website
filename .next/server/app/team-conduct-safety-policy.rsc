:{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"No earbuds, headphones, or AirPods while working at a client site. You must be able to hear coworkers, clients, alarms, and environmental sounds at all times."]}],["$","li","3",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Do not take photographs or videos of any client site, client materials, client employees, or work performed, except at the specific written direction of Miguel Garcia."]}],["$","li","4",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Do not post about client sites, client staff, or any work performed on social media. Any violation is grounds for immediate termination."]}],["$","li","5",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D",