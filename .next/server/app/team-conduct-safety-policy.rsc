e":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Eye irritation or chemical splashes."]}],["$","li","5",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Burns — thermal, chemical, or electrical."]}],["$","li","6",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Insect or animal bites."]}],["$","li","7",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Any incident involving a ladder, lift, or equipment, regardless of apparent injury."]}],["$","li","8",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Vehicle accidents involving Company vehicles or while on Company time."]}],["$","li","9",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Near-misses (no injury occurred, but could have) — reporting near-misses protects everyone."]}]]}],["$","p",null,{"children":["$","strong",null,{"children":"(e) How to Report."}]}],["$","ol",null,{"style":{"paddingLeft":22,"lineHeight":1.9},"children":[["$","li",null,{"children":["Call or text Miguel Garcia at ",["$","strong",null,{"children":"347-332-9348"}]," immediately (or email ",["$","strong",null,{"children":"info@greenpointms.com"}],")."]}],["$","li",null,{"children":["Submit the online ",["$","a",null,{"href":"/incident-report","style":{"color":"#1B7A3D","fontWeight":600},"children":"Company Incident Report form"}]," by end-of-shift or next business day."]}],["$","li",null,{"children":"Provide medical documentation within five (5) business days of any treatment."}],["$","li",null,{"children":"Cooperate fully with any workers' compensation claim, investigation, or return-to-work process."}]]}],["$","p",null,{"children":[["$","strong",null,{"children":"(f) Your Rights Under New York Law — Acknowledged."}]," New York Workers' Compensation Law gives you ",["$","strong",null,{"children":"thirty (30) days"}]," to report a workplace injury to your employer to preserve workers' compensation benefits. ",["$","strong",null,{"children":"Nothing in this policy shortens that legal deadline or affects your right to benefits."}]," The Company's internal same-day/seven-day policy is for operational and disciplinary purposes only. Late reporting may affect performance review and disciplinary standing but will ",["$","strong",null,{"children":"not"}]," be used to deny you workers' compensation benefits you are legally entitled to."]}],["$","p",null,{"children":[["$","strong",null,{"children":"(g) Emergencies."}]," For life-threatening injuries, ",["$","strong",null,{"children":"call 911 first"}],", then notify Miguel Garcia at 347-332-9348 as soon as reasonably possible."]}],["$","p",null,{"children":[["$","strong",null,{"children":"(h) No Retaliation."}]," GreenPoint will not retaliate against any Team Member for reporting an injury or filing a workers' compensation claim in good faith. Retaliation is illegal under New York law and a violation of this policy."]}]]}],["$","style",null,{"children":"\n        #section-3 p { margin: 0 0 14px 0; }\n        #section-3 p:last-child { margin-bottom: 0; }\n        #section-3 ul { margin: 0 0 14px 0; padding-left: 0; list-style: none; }\n        #section-3 ol { margin: 0 0 14px 0; }\n      "}]]}],["$","div",null,{"style":{"marginBottom":36,"scrollMarginTop":100},"id":"section-4","children":[["$","h2",null,{"style":{"fontFamily":"'Playfair Display', Georgia, serif","fontSize":22,"fontWeight":700,"color":"#0d2818","marginBottom":14,"display":"flex","alignItems":"baseline","gap":12,"flexWrap":"wrap"},"children":[["$","span",null,{"style":{"fontFamily":"'JetBrains Mono', monospace","fontSize":13,"color":"#1B7A3D","fontWeight":700,"letterSpacing":"0.05em"},"children":["§","4"]}],["$","span",null,{"children":"Personal Protective Equipment (PPE)"}],"$undefined"]}],["$","div",null,{"style":{"fontSize":15,"color":"#444","lineHeight":1.8},"children":[["$","p",null,{"children":"The Company provides required PPE at no cost. You must wear the appropriate PPE at all times when the task requires it."}],["$","ul",null,{"children":[["$","li","0",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Gloves — for all cleaning, chemical handling, and waste removal."]}],["$","li","1",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Safety glasses or goggles — for overhead work, chemical use, and pressurized equipment."]}],["$","li","2",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Slip-resistant, closed-toe footwear — required at all times on duty. No sandals, sneakers without slip resistance, or open-toe footwear ever."]}],["$","li","3",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Dust masks or N95 respirators — for dusty environments, mold-affected areas, or specific chemical use."]}],["$","li","4",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Back-support belts — when lifting heavy items (see Section 5)."]}],["$","li","5",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"High-visibility vest — in parking lots, loading docks, or near vehicular traffic."]}]]}],["$","p",null,{"children":"PPE must be worn correctly. Refusing or failing to use provided PPE is a disciplinary offense. Report any damaged, worn-out, or missing PPE to Miguel Garcia immediately."}]]}],["$","style",null,{"children":"\n        #section-4 p { margin: 0 0 14px 0; }\n        #section-4 p:last-child { margin-bottom: 0; }\n        #section-4 ul { margin: 0 0 14px 0; padding-left: 0; list-style: none; }\n        #section-4 ol { margin: 0 0 14px 0; }\n      "}]]}],["$","div",null,{"style":{"marginBottom":36,"scrollMarginTop":100},"id":"section-5","children":[["$","h2",null,{"style":{"fontFamily":"'Playfair Display', Georgia, serif","fontSize":22,"fontWeight":700,"color":"#0d2818","marginBottom":14,"display":"flex","alignItems":"baseline","gap":12,"flexWrap":"wrap"},"children":[["$","span",null,{"style":{"fontFamily":"'JetBrains Mono', monospace","fontSize":13,"color":"#C8A34D","fontWeight":700,"letterSpacing":"0.05em"},"children":["§","5"]}],["$","span",null,{"children":"Lifting, Pushing, Pulling & Ergonomics"}],["$","span",null,{"style":{"background":"rgba(200,163,77,0.12)","color":"#8a6d2a","padding":"2px 8px","borderRadius":4,"fontSize":10,"fontWeight":700,"fontFamily":"'JetBrains Mono', monospace","letterSpacing":"0.08em","textTransform":"uppercase","border":"1px solid rgba(200,163,77,0.3)"},"children":"Critical"}]]}],["$","div",null,{"style":{"fontSize":15,"color":"#444","lineHeight":1.8},"children":[["$","div",null,{"style":{"background":"rgba(200,163,77,0.08)","border":"1px solid rgba(200,163,77,0.3)","borderLeft":"3px solid #C8A34D","padding":"14px 18px","borderRadius":4,"marginBottom":18,"fontSize":14,"color":"#5a4a20","fontWeight":500},"children":["⚠️ ","Back injuries are one of the most common — and preventable — cleaning-industry injuries. Follow these rules without exception."]}],["$","p",null,{"children":[["$","strong",null,{"children":"(a) Solo Lifting Limit."}]," Do not lift any object heavier than ",["$","strong",null,{"children":"50 pounds"}]," alone. Above 50 pounds, you ",["$","strong",null,{"children":"must"}]," use a two-person team lift, a cart, a dolly, or request mechanical assistance."]}],["$","p",null,{"children":[["$","strong",null,{"children":"(b) Trash Bag Rule."}]," If a filled trash bag is heavier than ",["$","strong",null,{"children":"40 pounds"}]," or awkward to carry, ",["$","strong",null,{"children":"split it into two bags"}],". Never drag a heavy bag down stairs or across sharp surfaces that can tear it. Tie bags tightly before moving. Never reach into a bag without heavy-duty puncture-resistant gloves."]}],["$","p",null,{"children":[["$","strong",null,{"children":"(c) Pushing / Pulling Limit."}]," If moving a cart, mop bucket, floor machine, or any rolling load requires ",["$","strong",null,{"children":"more than both hands and normal walking effort"}]," — stop. Get help, split the load, or use a larger dolly. If you feel shoulder strain, chest tightness, or back tension, stop immediately and report it."]}],["$","p",null,{"children":["$","strong",null,{"children":"(d) Proper Lifting Technique."}]}],["$","ul",null,{"children":[["$","li","0",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Plan the lift before touching the object. Check the path for obstacles."]}],["$","li","1",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Stand close to the object, feet shoulder-width apart."]}],["$","li","2",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Squat down by bending the knees and hips — not the back."]}],["$","li","3",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Keep the load close to your body, at belt level when carrying."]}],["$","li","4",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Lift smoothly with your legs. Never jerk or twist."]}],["$","li","5",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Turn with your feet, not your waist."]}],["$","li","6",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Lower the load using the same technique — squat down with legs."]}]]}],["$","p",null,{"children":[["$","strong",null,{"children":"(e) Repetitive Motion."}]," For repetitive tasks (scrubbing, vacuuming, mopping long stretches), switch hands and take micro-breaks every 20–30 minutes. Report any recurring pain or tingling immediately (see Section 3)."]}],["$","p",null,{"children":[["$","strong",null,{"children":"(f) Awkward Positions."}]," Do not bend, kneel, or crouch for extended periods without breaks. Use kneepads for floor-level work. If a task requires sustained awkward posture, stop and contact Miguel Garcia."]}]]}],["$","style",null,{"children":"\n        #section-5 p { margin: 0 0 14px 0; }\n        #section-5 p:last-child { margin-bottom: 0; }\n        #section-5 ul { margin: 0 0 14px 0; padding-left: 0; list-style: none; }\n        #section-5 ol { margin: 0 0 14px 0; }\n      "}]]}],["$","div",null,{"style":{"marginBottom":36,"scrollMarginTop":100},"id":"section-6","children":[["$","h2",null,{"style":{"fontFamily":"'Playfair Display', Georgia, serif","fontSize":22,"fontWeight":700,"color":"#0d2818","marginBottom":14,"display":"flex","alignItems":"baseline","gap":12,"flexWrap":"wrap"},"children":[["$","span",null,{"style":{"fontFamily":"'JetBrains Mono', monospace","fontSize":13,"color":"#C8A34D","fontWeight":700,"letterSpacing":"0.05em"},"children":["§","6"]}],["$","span",null,{"children":"Slip, Trip & Fall Prevention — Mopping Rules"}],["$","span",null,{"style":{"background":"rgba(200,163,77,0.12)","color":"#8a6d2a","padding":"2px 8px","borderRadius":4,"fontSize":10,"fontWeight":700,"fontFamily":"'JetBrains Mono', monospace","letterSpacing":"0.08em","textTransform":"uppercase","border":"1px solid rgba(200,163,77,0.3)"},"children":"Critical"}]]}],["$","div",null,{"style":{"fontSize":15,"color":"#444","lineHeight":1.8},"children":[["$","div",null,{"style":{"background":"rgba(200,163,77,0.08)","border":"1px solid rgba(200,163,77,0.3)","borderLeft":"3px solid #C8A34D","padding":"14px 18px","borderRadius":4,"marginBottom":18,"fontSize":14,"color":"#5a4a20","fontWeight":500},"children":["⚠️ ","Wet floors are the #1 cause of injury claims in cleaning. These rules are non-negotiable."]}],["$","p",null,{"children":[["$","strong",null,{"children":"(a) Wet-Floor Signs — Always."}]," Place “Wet Floor” signs at both ends of any area being mopped or recently cleaned, ",["$","strong",null,{"children":"before"}]," you start mopping. Signs must remain in place until the floor is fully dry. ",["$","strong",null,{"children":"No exceptions"}],", even if the area is small or “only takes a minute.”"]}],["$","p",null,{"children":["$","strong",null,{"children":"(b) Mopping Technique — Backward “S” Pattern."}]}],["$","ul",null,{"children":[["$","li","0",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Always mop backward, working away from yourself toward the exit or already-cleaned area. Never walk across a floor you have just mopped."]}],["$","li","1",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Use a figure-8 or S-pattern to cover the area evenly without stepping in the wet section."]}],["$","li","2",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Wring the mop properly — an over-wet mop creates standing water and slip hazards."]}],["$","li","3",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Change mop water frequently (every 500–1,000 sq ft or when visibly dirty). Dirty water leaves a residue that is more slippery than dry dirt."]}],["$","li","4",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Do not mop an area with foot traffic without first blocking it off with signs or a partner posted as spotter."]}]]}],["$","p",null,{"children":["$","strong",null,{"children":"(c) Your Own Footing — How to Step."}]}],["$","ul",null,{"children":[["$","li","0",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Wear slip-resistant shoes at all times. Inspect treads weekly; replace worn shoes."]}],["$","li","1",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Take shorter steps on any wet, waxed, or freshly mopped surface."]}],["$","li","2",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Keep your center of gravity over your front foot. Do not lean sideways."]}],["$","li","3",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"If you must cross a wet area, walk slowly, with flat feet, and hold onto a stable surface if possible."]}],["$","li","4",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Never run at a client site. Never."]}],["$","li","5",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Use handrails on all stairs — both directions. Do not carry loads up or down stairs without one free hand for the railing."]}]]}],["$","p",null,{"children":[["$","strong",null,{"children":"(d) Spill Response."}]," Clean up spills immediately. Do not leave cords, hoses, mop buckets, or equipment in walkways. Report any structural hazards (loose tiles, damaged flooring, broken handrails, uneven transitions) to Miguel Garcia and the client contact on the same day."]}],["$","p",null,{"children":[["$","strong",null,{"children":"(e) Floor Waxing & Stripping."}]," Only Team Members trained in floor care may strip, wax, or buff floors. The entire area must be roped off or physically blocked from pedestrian access for the full curing period. Never perform floor care during business hours without written client authorization."]}]]}],["$","style",null,{"children":"\n        #section-6 p { margin: 0 0 14px 0; }\n        #section-6 p:last-child { margin-bottom: 0; }\n        #section-6 ul { margin: 0 0 14px 0; padding-left: 0; list-style: none; }\n        #section-6 ol { margin: 0 0 14px 0; }\n      "}]]}],["$","div",null,{"style":{"marginBottom":36,"scrollMarginTop":100},"id":"section-7","children":[["$","h2",null,{"style":{"fontFamily":"'Playfair Display', Georgia, serif","fontSize":22,"fontWeight":700,"color":"#0d2818","marginBottom":14,"display":"flex","alignItems":"baseline","gap":12,"flexWrap":"wrap"},"children":[["$","span",null,{"style":{"fontFamily":"'JetBrains Mono', monospace","fontSize":13,"color":"#1B7A3D","fontWeight":700,"letterSpacing":"0.05em"},"children":["§","7"]}],["$","span",null,{"children":"Chemical Safety"}],"$undefined"]}],["$","div",null,{"style":{"fontSize":15,"color":"#444","lineHeight":1.8},"children":["$","ul",null,{"children":[["$","li","0",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Only use Company-approved chemicals. Do not bring personal cleaning products."]}],["$","li","1",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Never mix chemicals — especially bleach and ammonia, which create toxic chloramine gas."]}],["$","li","2",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Never mix different brands of the same product type without supervisor approval."]}],["$","li","3",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Store chemicals upright, capped, and labeled in their original containers. Never transfer chemicals to unmarked bottles."]}],["$","li","4",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Review the Safety Data Sheet (SDS) for any chemical you have not used before. SDS binders are available from Miguel Garcia on request."]}],["$","li","5",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Ventilate the area when using strong chemicals. Open windows or turn on exhaust fans."]}],["$","li","6",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"Use the correct dilution ratios. Stronger is not better and can damage surfaces or cause skin burns."]}],["$","li","7",{"style":{"paddingLeft":28,"paddingBottom":10,"position":"relative","fontSize":15,"color":"#444","lineHeight":1.7},"children":[["$","span",null,{"style":{"position":"absolute","left":0,"top":2,"width":18,"height":18,"borderRadius":"50%","background":"rgba(27,122,61,0.1)","color":"#1B7A3D","fontSize":11,"fontWeight":700,"display":"flex","alignItems":"center","justifyContent":"center","fontFamily":"'JetBrains Mono', monospace"},"children":"✓"}],"If a chemical splashes in your eyes or on your skin, flush with water for 15+ minutes and call Miguel Garcia immediately."]}]]}]}],["$","style",null,{"children":"\n        #section-7 p { margin: 0 0 14px 0; }\n        #section-7 p:last-child { margin-bottom: 0; }\n        #section-7 ul { margin: 0 0 14px 0; padding-left: 0; list-style: none; }\n        #section-7 ol { margin: 0 0 14px 0; }\n      "}]]}],["$","div",null,{"style":{"marginBottom":36,"scrollMarginTop":100},"id":"section-8","children":[["$","h2",null,{"style":{"fontFa